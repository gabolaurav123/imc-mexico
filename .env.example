DEBUG=true
SECRET_KEY=replace-with-a-random-secret
PUBLIC_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# In local development only, an absent DATABASE_URL selects SQLite.
DATABASE_URL=
# Comma-separated CIDRs of reverse proxies allowed to supply X-Forwarded-For.
# Leave blank unless the deployment is behind a configured proxy.
TRUSTED_PROXY_CIDRS=
# Direct Neon endpoint for the serialized deployment migration command.
DIRECT_URL=
PORT=8000
ADMIN_EMAIL=
MEDIA_ROOT=media
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT=90
AI_JOB_STALE_SECONDS=600
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=
# Optional monitored reply mailbox; one address, optionally with a display name.
EMAIL_REPLY_TO=
# Optional external storage instead of a Seenode persistent volume:
PRIVATE_S3_BUCKET=
PRIVATE_S3_ENDPOINT_URL=
PRIVATE_S3_REGION=
PRIVATE_S3_ACCESS_KEY_ID=
PRIVATE_S3_SECRET_ACCESS_KEY=

# Controlled acceptance fixtures only; leave false for new installations
IMPORT_SYNTHETIC_TEST_MEDIA=false
WEB_WORKERS=1
WEB_THREADS=1
# The web and worker share MEDIA_ROOT in the single-container deployment. The
# web process writes this local signal after queue commits; leave blank to use
# MEDIA_ROOT/.imc-worker-wake.
WORKER_WAKE_FILE=
# Idle database fallback: 3, 6, 12... seconds up to 15 minutes. The local
# wake file is checked every 0.5 seconds and does not open a database connection.
WORKER_IDLE_BACKOFF_INITIAL=3
WORKER_IDLE_BACKOFF_MAX=900
WORKER_WAKE_CHECK_SECONDS=0.5
# For five minutes after a processed analysis, preserve prompt polling for a
# retry whose lease becomes eligible soon.
WORKER_RETRY_POLL_MAX=15
BACKUP_DIR=/data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
